{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thrnai",
  "main": "src/worker.ts",
  "ai": {
    "binding": "AI"
  },

  "compatibility_date": "2025-02-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/auth/*"
    ],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
